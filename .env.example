# BPK Hub Frontend — Environment Variables
# Copy this file to .env.local and fill in values

# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Staging
# NEXT_PUBLIC_API_URL=https://bpkhub-api-staging.up.railway.app

# Production
# NEXT_PUBLIC_API_URL=https://api.bpkhub.co.kr

# Supabase (public keys only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
